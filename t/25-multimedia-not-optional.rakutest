use Test;

# Every binary this distribution produces is expected to carry the FFmpeg
# multimedia backend. src/media/ffmpeg.c in notcurses is wrapped entirely in
# `#ifdef USE_FFMPEG`, so a build configured -DUSE_MULTIMEDIA=none compiles it
# to nothing: ncvisual_from_file() then fails at runtime and image/video
# support is simply absent. Nothing downstream can detect that from the
# outside, so a source build must never quietly choose it.
#
# Build.rakumod used to retry with -DUSE_MULTIMEDIA=none whenever the cmake
# configure step failed, emitting only a `note`. A user missing the FFmpeg
# headers therefore got a silently degraded library and found out when an
# image failed to render. The fallback now requires an explicit opt-in.
#
# These are source-contract tests rather than behavioural ones: exercising the
# real path needs a cmake configure failure, which cannot be provoked
# hermetically. What matters, and what is checkable here, is that the
# downgrade cannot be reached without the opt-in.

my IO::Path $build = $*PROGRAM.parent.parent.child('Build.rakumod');
my Str $src = $build.slurp;

plan 7;

ok $build.e, 'Build.rakumod exists';

ok $src.contains('-DUSE_MULTIMEDIA=ffmpeg'),
    'the configure step asks for the ffmpeg multimedia backend';

ok $src.contains('NOTCURSES_NATIVE_ALLOW_NO_MULTIMEDIA'),
    'the core-only fallback is gated behind an explicit opt-in env var';

# The downgrade assignment must be dominated by the opt-in check. Compare
# source offsets: if the guard does not appear before the assignment, the
# fallback is reachable without it.
my Int $guard-at    = $src.index('NOTCURSES_NATIVE_ALLOW_NO_MULTIMEDIA');
my Int $downgrade-at = $src.index("'-DUSE_MULTIMEDIA=none'");

ok $downgrade-at.defined, 'the core-only downgrade is still implemented';
ok $guard-at.defined && $guard-at < $downgrade-at,
    'the opt-in check precedes the downgrade, so it cannot be bypassed';

subtest 'a failed configure dies by default rather than degrading' => {
    plan 2;
    # The `unless <opt-in> { die ... }` shape is what makes the default path
    # fatal: the opt-in is a negated guard, and the branch it guards dies.
    my Str $guard-line =
        $src.lines.first(*.contains('NOTCURSES_NATIVE_ALLOW_NO_MULTIMEDIA'));
    ok $guard-line.defined && $guard-line.contains('unless'),
        'the opt-in is a negated guard, so the unset default takes the branch';
    my Str $between = $src.substr($guard-at, $downgrade-at - $guard-at);
    ok $between.contains('die'),
        'and that branch dies rather than falling through to the downgrade';
};

subtest 'the failure message tells the user how to fix it' => {
    plan 4;
    # A bare "configure failed" leaves the user guessing; the whole point of
    # failing loudly is that the next step is obvious. One hint per platform
    # this distribution supports building on.
    ok $src.contains('libavdevice-dev'), 'Debian/Ubuntu remedy is named';
    ok $src.contains('ffmpeg-devel'),    'Fedora remedy is named';
    ok $src.contains('brew install ffmpeg'), 'macOS remedy is named';
    ok $src.contains('mingw-w64-ucrt-x86_64-ffmpeg'),
        'MSYS2/UCRT64 remedy is named';
};

done-testing;
