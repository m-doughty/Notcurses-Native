use v6.d;
use Test;
use NativeCall;
use lib $*PROGRAM.parent.parent.add('lib').Str;
use Notcurses::Native;

# Rakudo 2026.09 builds $*DISTRO afresh on every read, and on macOS each
# build leaves a pipe open: every read of $*DISTRO, and of $*KERNEL.name or
# .arch, which ask $*DISTRO for their answer, keeps one file descriptor for
# good.  Loading this dist reads them about seventeen times, and a TUI built
# on it runs at macOS's default limit of 256 descriptors.  The dist files the
# first $*DISTRO under the key the lookup reads (see the top of
# Notcurses::Native::Str); this file counts.
#
# The counts come from the kernel: the descriptor listing on Linux and macOS,
# GetProcessHandleCount on Windows.  Every comparison is between two readings
# taken around the same work, after that work has already run once, so that
# whatever a first call opens for good is in both.  The leak this file exists
# for is per read, so a few hundred reads show it in the hundreds; SLACK is
# the most the count may drift by.

plan 3;

# Read once, here: a counter that read $*DISTRO on every call would, on the
# Rakudo this file is about, be counting its own leak.
my constant IS-WIN = $*DISTRO.is-win;
my constant READS  = 300;
my constant SLACK  = 10;

# Windows publishes no listing of a process's handles; kernel32 counts them.
# Bound lazily by NativeCall, so declaring them costs a POSIX process nothing.
my sub win-current-process(--> Pointer)
	is native('kernel32') is symbol('GetCurrentProcess') { * }
my sub win-process-handle-count(Pointer, uint32 is rw --> int32)
	is native('kernel32') is symbol('GetProcessHandleCount') { * }

# How many files, pipes, sockets and other handles this process holds open.
# The listing's own directory handle is in every reading, so it cancels out
# of a difference; it is read to its end (.elems) because a listing left
# unfinished keeps its handle open after the reading is taken.  Windows counts
# thread and event handles too, so only a difference means anything.
sub open-handle-count(--> Int:D) {
	if IS-WIN {
		my uint32 $count = 0;
		die 'open-handle-count: GetProcessHandleCount failed'
			unless win-process-handle-count(win-current-process(), $count);
		return $count;
	}
	for '/proc/self/fd', '/dev/fd' -> $listing {
		my $count = try $listing.IO.dir.elems;
		return $count if $count.defined;
	}
	die 'open-handle-count: this host publishes no list of the descriptors a process holds';
}

#| How far the handle count moved across &work, which has already run once.
sub drift(&work --> Int:D) {
	work();
	my Int:D $before = open-handle-count();
	work();
	open-handle-count() - $before;
}

ok $*DISTRO === $*DISTRO, 'Two reads of $*DISTRO return the same object';

subtest 'reads of $*DISTRO and $*KERNEL hold no handle open' => {
	plan 3;

	my Int:D $distro = drift({ my $name; $name = $*DISTRO.name for ^READS });
	ok $distro <= SLACK,
		"{READS} reads of \$*DISTRO.name hold no handle open (the count moved by $distro)";

	my Int:D $kernel = drift({ my $name; $name = $*KERNEL.name for ^READS });
	ok $kernel <= SLACK,
		"nor do {READS} reads of \$*KERNEL.name (the count moved by $kernel)";

	my Int:D $arch = drift({ my $arch; $arch = $*KERNEL.arch for ^READS });
	ok $arch <= SLACK,
		"nor do {READS} reads of \$*KERNEL.arch (the count moved by $arch)";
};

subtest 'the platform constants the dist computed at load are real' => {
	plan 2;

	ok $Notcurses::Native::os.chars, 'The kernel name was read at load';
	ok $Notcurses::Native::ext eq any(<dylib dll so>),
		"The library extension is one of the three platform ones ($Notcurses::Native::ext)";
};
