use v6.d;
use Test;
use lib $*PROGRAM.parent.parent.add('lib').Str;

# The dist files the first $*DISTRO and $*KERNEL it reads under the keys
# Rakudo's lookup asks for, so each object is built once per process rather
# than once per read (see the top of Notcurses::Native::Str, and t/45).  It
# must only ever file real ones.  A test that fakes Windows declares a
# stand-in $*DISTRO; a module loaded while it is in scope reads it.  Filing
# it would make every later read in the process -- in every module, long after
# the test's scope has closed -- answer "Windows".
#
# Its own file because the module loads once per process: this has to be the
# first load, and it has to happen at run time, inside the stand-in's scope.
# Notcurses::Native::Str is the module that carries the pin, and the first one
# every other module of the dist loads.

plan 5;

my class FakeWinDistro {
	method is-win { True }
}
my class FakeKernel {
	method name { 'win32' }
	method arch { 'fixture-arch' }
}

my Bool $loaded = False;
{
	my $*DISTRO = FakeWinDistro.new;
	my $*KERNEL = FakeKernel.new;
	require ::('Notcurses::Native::Str');
	$loaded = True;
}

ok $loaded, 'The module loaded inside the stand-in';
nok PROCESS::<$DISTRO> ~~ FakeWinDistro,
	'The stand-in in force while it loaded was not filed for the process';
ok $*DISTRO ~~ Distro:D, 'Outside the stand-in, $*DISTRO is the real one';
nok PROCESS::<$KERNEL> ~~ FakeKernel,
	'The kernel stand-in in force while it loaded was not filed for the process';
ok $*KERNEL ~~ Kernel:D, 'Outside the stand-in, $*KERNEL is the real one';
